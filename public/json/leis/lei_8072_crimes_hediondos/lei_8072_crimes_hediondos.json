{
  "documento": {
    "id": "doc_lei_8072_crimes_hediondos",
    "tipo": "lei_nacional",
    "titulo": "Lei 8072 Crimes Hediondos",
    "apelido": "Lei 8072 Crimes Hediondos",
    "sigla": "",
    "lei": {
      "numero": "8.072",
